            },
            {
              "var": "need_dev",
              "op": "add",
              "value": 2
            }
          ],
          "transitions": []
        },
        {
          "id": "omni",
          "label": "A web portal plus companion iOS / Android apps",
          "effects": [
            {
              "var": "web",
