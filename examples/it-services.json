        {
          "id": "desktop",
          "label": "Desktop software, embedded or a game",
          "effects": [
            {
              "var": "off_platform",
              "op": "set",
              "value": 1
            }
          ],
          "transitions": [
            {
              "id": "t5",
              "to": "off_platform"
            }
          ]
        }
      ],
      "transitions": [
        {
          "id": "t6",
          "to": "size",
          "when": {
            "type": "not",
