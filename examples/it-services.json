{
  "schemaVersion": 1,
  "id": "example-it-services",
  "title": "Kestrel Digital – are we the right partner?",
  "description": "Example: helps a prospective customer decide whether to engage an IT services company that serves upper-mid to extra-large organisations (architecture, DevOps, development, testing for web & mobile).",
  "startNodeId": "start",
  "variables": [
    {
      "key": "intent_build",
      "label": "Wants to build something new",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "intent_improve",
      "label": "Wants to improve an existing system",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "intent_advice",
      "label": "Wants expert advice",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "size",
      "label": "Company size tier",
      "initial": 0,
      "min": 0,
      "max": 5,
      "description": "0 = unknown, 1 = <10 people … 5 = 2000+"
    },
    {
      "key": "budget",
      "label": "Budget tier",
      "initial": 0,
      "min": 0,
      "max": 4,
      "description": "0 = unknown, 1 = <€15k … 4 = €300k+"
    },
    {
      "key": "complexity",
      "label": "Solution complexity score",
      "initial": 0,
      "min": 0
    },
    {
      "key": "fit",
      "label": "Fit score",
      "description": "How well the customer matches our sweet spot (can go negative).",
      "initial": 0
    },
    {
      "key": "web",
      "label": "Web platform involved",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "mobile",
      "label": "Mobile platform involved",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "off_platform",
      "label": "Needs something other than web/mobile",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "has_team",
      "label": "Has an in-house dev team",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "regulated",
      "label": "Regulated / high-stakes environment",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "pains",
      "label": "Number of pain points picked",
      "initial": 0,
      "min": 0,
      "max": 5
    },
    {
      "key": "pain_release",
      "label": "Pain: slow or risky releases",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "pain_outage",
      "label": "Pain: outages",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "pain_bugs",
      "label": "Pain: bugs reach users",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "pain_scale",
      "label": "Pain: cannot scale",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "pain_capacity",
      "label": "Pain: not enough delivery capacity",
      "initial": 0,
      "min": 0,
      "max": 1
    },
    {
      "key": "need_arch",
      "label": "Need: architecture",
      "initial": 0,
      "min": 0
    },
    {
      "key": "need_devops",
      "label": "Need: DevOps",
      "initial": 0,
      "min": 0
    },
    {
      "key": "need_dev",
      "label": "Need: development",
      "initial": 0,
      "min": 0
    },
    {
      "key": "need_qa",
      "label": "Need: testing / QA",
      "initial": 0,
      "min": 0
    }
  ],
  "nodes": [
    {
      "id": "start",
      "kind": "question",
      "title": "What brings you here today?",
      "body": "Answer a few quick questions and we'll tell you honestly whether we are the right partner – or point you somewhere better.",
      "onEnter": [],
      "choices": [
        {
          "id": "build",
          "label": "We want to build a new website, portal or app",
          "effects": [
            {
              "var": "intent_build",
              "op": "set",
              "value": 1
            }
          ],
          "transitions": [
            {
              "id": "t1",
              "to": "what_build"
            }
          ]
        },
        {
          "id": "improve",
          "label": "We have a system that needs help (delivery speed, stability, quality)",
          "effects": [
            {
              "var": "intent_improve",
              "op": "set",
              "value": 1
            }
          ],
          "transitions": [
            {
              "id": "t2",
              "to": "size"
            }
          ]
        },
        {
          "id": "advice",
          "label": "We need expert advice or a second opinion",
          "effects": [
            {
              "var": "intent_advice",
              "op": "set",
              "value": 1
            }
          ],
          "transitions": [
            {
              "id": "t3",
              "to": "size"
            }
          ]
        },
        {
          "id": "explore",
          "label": "Just looking around",
          "effects": [],
          "transitions": [
            {
              "id": "t4",
              "to": "size"
            }
          ]
        }
      ],
      "transitions": []
    },
    {
