            },
            {
              "var": "need_arch",
              "op": "add",
              "value": 1
            },
            {
              "var": "need_dev",
              "op": "add",
              "value": 2
            },
            {
              "var": "fit",
              "op": "add",
              "value": 2
            }
          ],
          "transitions": []
        },
        {
          "id": "mobile_app",
          "label": "A mobile app",
          "effects": [
            {
              "var": "mobile",
