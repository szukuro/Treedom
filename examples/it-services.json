        {
          "id": "internal",
          "label": "An internal enterprise platform (workflows, dashboards, integrations)",
          "effects": [
            {
              "var": "web",
              "op": "set",
              "value": 1
            },
            {
              "var": "complexity",
              "op": "add",
              "value": 4
            },
            {
              "var": "need_arch",
              "op": "add",
              "value": 1
            },
            {
              "var": "need_dev",
              "op": "add",
              "value": 2
            },
            {
              "var": "fit",
              "op": "add",
              "value": 1
            }
          ],
          "transitions": []
