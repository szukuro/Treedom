{
  "name": "treedom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stateful, non-linear decision trees: a login-gated editor that exports decision.json, and a standalone static viewer that plays it.",
  "scripts": {
    "dev": "vite --mode editor",
    "dev:viewer": "vite --mode viewer",
    "build": "tsc && vite build --mode editor && vite build --mode viewer",
    "build:editor": "tsc && vite build --mode editor",
    "build:viewer": "tsc && vite build --mode viewer",
    "preview:editor": "vite preview --mode editor",
    "preview:viewer": "vite preview --mode viewer",
    "typecheck": "tsc",
    "test": "vitest run",
    "export-example": "UPDATE_EXAMPLES=1 vitest run src/examples/exportJson.test.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
